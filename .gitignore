# Generated by Cargo
# will have compiled files and executables
/target/
**/target/

# Remove Cargo.lock from lib? Check this note from Cargo:
# https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
# [Cargo.toml] is a manifest in which we can specify a bunch of different metadata about our package.
# [Cargo.lock] is a file that contains exact information about our dependencies.
# For libraries, check in Cargo.toml. For binaries, check in Cargo.lock?
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds, if using MSVC
*.pdb

# Runtime data
*.dmp

# OS or Editor folders
.DS_Store
._*
*.swp
*.swo
*~

# OS specific
Thumbs.db

# IDE and editor files
# VS Code
.vscode/
!.vscode/extensions.json
*.code-workspace

# IntelliJ
.idea/
*.iml

# Eclipse
.settings/
.project
.classpath

# Emacs
*~
\#*\#
.\#*

# Vim
[._]*.s[a-w][a-z]
[._]s[a-w][a-z]
*.un~
Session.vim
.netrwhist

# Rust Analyzer
.rust-analyzer/

# Cargo local registry and source
.cargo/registry/
.cargo/git/

# Rustup toolchain installations
# Only ignore if you're building toolchains
# ~/.rustup/ should generally not be in a project

# Build results
build/
dist/

# Coverage files
*.profraw
*.gcda
*.gcno
**/coverage/
*.lcov

# Profiling
*.exp
*.map
*.dSYM/

# Environment files
.env
.env.local
.env.*.local

# Logs
*.log
logs/

# Runtime data for benchmarks and tests
benches/output/
tests/output/

# Temporary files
tmp/
temp/

# Documentation
/doc/
/target/doc/

# Package releases
/*.tar.gz
/*.zip

# Backup files
*.bak
*.backup